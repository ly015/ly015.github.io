<div class="news">
  {% assign news = site.news | sort: 'date' | reverse %}
  {% if include.limit and page.announcements.min_year %}
    {% assign min_year = page.announcements.min_year | plus: 0 %}
    {% assign filtered_news = '' | split: ',' %}
    {% for item in news %}
      {% assign item_year = item.date | date: '%Y' | plus: 0 %}
      {% if item_year >= min_year %}
        {% assign filtered_news = filtered_news | push: item %}
      {% endif %}
    {% endfor %}
    {% assign news = filtered_news %}
  {% endif %}
  {% assign news_size = news | size %}
  {% if news_size > 0 %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
